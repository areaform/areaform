{
    "name": "@areaform/render-2d",
    "version": "0.1.0",
    "license": "MIT",
    "homepage": "https://github.com/areaform/areaform/tree/main/packages/render-2d#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/areaform/areaform.git",
        "directory": "packages/render-2d"
    },
    "bugs": {
        "url": "https://github.com/areaform/areaform/issues"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "dist",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json",
        "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
    },
    "dependencies": {
        "@areaform/core": "workspace:*",
        "pixi.js": "^8.22.0"
    },
    "devDependencies": {
        "vitest": "^5.0.5"
    }
}
