{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": ["src", "types"],
    "exclude": ["src/**/*.test.ts", "src/testing.ts"]
}
