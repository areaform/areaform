{
    "name": "@areaform/mcp",
    "version": "0.1.0",
    "license": "MIT",
    "homepage": "https://github.com/areaform/areaform/tree/main/packages/mcp#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/areaform/areaform.git",
        "directory": "packages/mcp"
    },
    "bugs": {
        "url": "https://github.com/areaform/areaform/issues"
    },
    "type": "module",
    "sideEffects": false,
    "bin": {
        "areaform-mcp": "./src/main.ts"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "dist",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "bin": {
            "areaform-mcp": "./dist/main.js"
        },
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "start": "node src/main.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
    },
    "dependencies": {
        "@areaform/core": "workspace:*",
        "@areaform/render-3d": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@resvg/resvg-js": "^2.6.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "vitest": "^5.0.5"
    }
}
