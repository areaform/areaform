{
    "name": "@areaform/playground",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.json && vite build",
        "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
        "preview": "vite preview",
        "test": "vitest run",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@areaform/core": "workspace:*",
        "@areaform/editor": "workspace:*",
        "@areaform/render-2d": "workspace:*",
        "@areaform/view": "workspace:*",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
